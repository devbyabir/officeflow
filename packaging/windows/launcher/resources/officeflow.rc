// Resources linked into OfficeFlow.exe: its icon (shown in Explorer, the Start menu and the
// taskbar), version information and application manifest. CI writes version.h (the version
// from server/pom.xml) and compiles this file, from the launcher folder, with windres into
// rsrc_windows_amd64.syso, which `go build` links automatically:
//   windres -O coff -F pe-x86-64 -I . -i resources/officeflow.rc -o rsrc_windows_amd64.syso
#if defined(__has_include)
#if __has_include("version.h")
#include "version.h"
#endif
#endif
#ifndef VERSION_COMMA
#define VERSION_COMMA 1,0,0,0
#endif
#ifndef VERSION_TEXT
#define VERSION_TEXT "1.0.0"
#endif

1 ICON "../icon/officeflow.ico"
1 24 "resources/officeflow.manifest"

1 VERSIONINFO
FILEVERSION VERSION_COMMA
PRODUCTVERSION VERSION_COMMA
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "devbyabir"
      VALUE "FileDescription", "OfficeFlow"
      VALUE "FileVersion", VERSION_TEXT
      VALUE "InternalName", "OfficeFlow"
      VALUE "LegalCopyright", "Copyright (c) 2026 devbyabir"
      VALUE "OriginalFilename", "OfficeFlow.exe"
      VALUE "ProductName", "OfficeFlow"
      VALUE "ProductVersion", VERSION_TEXT
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
